diff --git a/include/ksmaudio/Diagnostics.hpp b/include/ksmaudio/Diagnostics.hpp
new file mode 100644
--- /dev/null
+++ b/include/ksmaudio/Diagnostics.hpp
@@ -0,0 +1,224 @@
+#pragma once
+// Opt-in QA flight recorder. Producers never do file I/O or acquire a logger lock.
+// Labels must be static string literals. Each producer owns its bounded ring.
+#include <atomic>
+#include <array>
+#include <thread>
+#include <chrono>
+#include <filesystem>
+#include <fstream>
+#include <string_view>
+#include <stdexcept>
+#include <string>
+#include <cstring>
+#include <cstdint>
+#include <algorithm>
+#include <utility>
+#ifdef _WIN32
+#include <Windows.h>
+#endif
+
+namespace ksmaudio::qa {
+inline constexpr unsigned LaneCount=32, Capacity=512;
+inline std::uint64_t Now() noexcept {
+#ifdef _WIN32
+    return GetTickCount64();
+#else
+    return std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+#endif
+}
+struct Cell {
+    std::atomic<std::uint64_t> sequence{0}, tick{0}, a{0}, b{0};
+    std::atomic<const char*> label{nullptr};
+    std::array<std::atomic<std::uint64_t>,16> text{};
+};
+struct Lane {
+    std::atomic<unsigned> tid{0};
+    std::atomic<const char*> role{"worker"}, phase{"idle"};
+    std::atomic<std::uint64_t> touched{0}, entered{0}, count{0};
+    std::array<Cell,Capacity> ring{};
+};
+inline std::array<Lane,LaneCount> lanes;
+inline std::atomic<bool> enabled{false}, stopping{false}, writerFailed{false};
+inline std::atomic<unsigned> allocated{0};
+inline std::atomic<std::uint64_t> overflowThreads{0}, frame{0}, frameTick{0};
+inline std::atomic<std::int64_t> gameUs{0};
+inline std::atomic<std::uint64_t> callbacks{0}, audioFrames{0};
+static_assert(std::atomic<std::uint64_t>::is_always_lock_free);
+static_assert(std::atomic<const char*>::is_always_lock_free);
+inline std::atomic<const char*> scene{"startup"};
+inline std::thread writer;
+inline std::filesystem::path sessionPath;
+inline Lane* Current() noexcept {
+    if (!enabled.load(std::memory_order_relaxed)) return nullptr;
+    static thread_local Lane* lane=[]() noexcept -> Lane* {
+        const auto n=allocated.fetch_add(1);
+        if (n>=LaneCount) { ++overflowThreads; return nullptr; }
+        auto& value=lanes[n];
+#ifdef _WIN32
+        value.tid=GetCurrentThreadId();
+#else
+        value.tid=n+1;
+#endif
+        value.touched=Now(); value.entered=Now();
+        return &value;
+    }();
+    return lane;
+}
+inline void Role(const char* role) noexcept { if(auto* l=Current()) l->role.store(role); }
+inline void Event(const char* label, std::uint64_t a=0, std::uint64_t b=0,
+    std::string_view text={}) noexcept {
+    auto* l=Current(); if(!l) return;
+    const auto ticket=l->count.load(std::memory_order_relaxed);
+    auto& cell=l->ring[ticket%Capacity];
+    cell.sequence.store(ticket*2+1,std::memory_order_release);
+    cell.tick=Now(); cell.label=label; cell.a=a; cell.b=b;
+    std::array<std::uint64_t,16> bytes{};
+    if(!text.empty()) std::memcpy(bytes.data(),text.data(),(std::min)(text.size(),sizeof(bytes)-1));
+    for(unsigned i=0;i<bytes.size();++i) cell.text[i].store(bytes[i],std::memory_order_relaxed);
+    cell.sequence.store(ticket*2+2,std::memory_order_release);
+    l->count.store(ticket+1,std::memory_order_release);
+}
+inline void Phase(const char* phase) noexcept {
+    if(auto* l=Current()) { l->phase=phase; l->entered=Now(); l->touched=Now(); }
+}
+class Scope {
+    Lane* lane=nullptr; const char* previous=nullptr; const char* label=nullptr;
+    std::uint64_t started=0, handle=0; bool events=false;
+public:
+    explicit Scope(const char* name, bool record=false, std::uint64_t value=0) noexcept
+        : lane(Current()),label(name),handle(value),events(record) {
+        if(!lane) return;
+        previous=lane->phase.load(); started=Now(); Phase(name);
+        if(events) Event("BEGIN",value,0,name);
+    }
+    ~Scope() {
+        if(!lane) return;
+        if(events) Event("END",handle,Now()-started,label);
+        lane->phase=previous; lane->entered=Now(); lane->touched=Now();
+    }
+};
+template<class F, class E> auto Call(const char* name, std::uint64_t handle, F&& call, E&& error) {
+    Scope scope{name,true,handle};
+    auto result=call();
+    const auto code=enabled && !result ? static_cast<std::uint64_t>(error()) : 0;
+    Event("RESULT",handle,static_cast<std::uint64_t>(result),name);
+    if(!result) Event("ERROR",handle,code,name);
+    return result;
+}
+template<class F> auto Call(const char* name, std::uint64_t handle, F&& call) {
+    return Call(name,handle,std::forward<F>(call),[]{return 0;});
+}
+inline void FrameBegin() noexcept {
+    if(!enabled.load(std::memory_order_relaxed)) return;
+    frame.fetch_add(1,std::memory_order_relaxed); frameTick=Now(); Phase("System::Update");
+}
+inline void Scene(const char* name) noexcept { if(enabled) scene=name; }
+inline void GameTime(double seconds) noexcept { if(enabled) gameUs=static_cast<std::int64_t>(seconds*1000000); }
+
+inline void WriterLoop() noexcept {
+    try {
+        unsigned part=0;
+        std::uint64_t bytes=0, generation=0, lastHeartbeat=0, lastGameChange=Now();
+        std::int64_t previousGameUs=0;
+        std::array<std::uint64_t,LaneCount> consumed{};
+        std::ofstream out;
+        auto open=[&] {
+            out.close(); out.clear();
+            out.open(sessionPath/("events-"+std::to_string(part)+".log"),std::ios::trunc);
+            if(!out) throw std::runtime_error("Cannot open QA event log");
+            out << "QA_LOG_V1 generation=" << generation << " tick_ms label a b text; END b=elapsed_ms\n";
+            bytes=0;
+        };
+        open();
+        while(true) {
+            const bool finalDrain=stopping.load();
+            const auto count=(std::min)(allocated.load(),LaneCount);
+            for(unsigned i=0;i<count;++i) {
+                auto& lane=lanes[i];
+                const auto end=lane.count.load(std::memory_order_acquire);
+                auto& next=consumed[i];
+                if(end>next+Capacity) {
+                    out << Now() << " LOST lane=" << i << " events=" << end-next-Capacity << '\n';
+                    next=end-Capacity;
+                }
+                while(next<end) {
+                    auto& cell=lane.ring[next%Capacity];
+                    const auto expected=next*2+2;
+                    if(cell.sequence.load(std::memory_order_acquire)!=expected) { ++next; continue; }
+                    const auto tick=cell.tick.load(),a=cell.a.load(),b=cell.b.load();
+                    const auto* label=cell.label.load();
+                    std::array<std::uint64_t,16> words{};
+                    for(unsigned j=0;j<words.size();++j) words[j]=cell.text[j].load();
+                    if(cell.sequence.load(std::memory_order_acquire)!=expected) { ++next; continue; }
+                    auto* text=reinterpret_cast<char*>(words.data()); text[sizeof(words)-1]=0;
+                    for(unsigned j=0;j<sizeof(words);++j)
+                        if(text[j]=='\n'||text[j]=='\r'||text[j]=='\t') text[j]=' ';
+                    out << tick << " lane=" << i << " tid=" << lane.tid.load()
+                        << " " << (label?label:"?") << " " << a << " " << b << " " << text << '\n';
+                    ++next;
+                }
+            }
+            const auto now=Now();
+            if(now-lastHeartbeat>=1000 || stopping.load()) {
+                const auto positionUs=gameUs.load();
+                if(positionUs!=previousGameUs) { previousGameUs=positionUs; lastGameChange=now; }
+                out << now << " HEARTBEAT frame=" << frame.load()
+                    << " main_age_ms=" << now-frameTick.load() << " scene=" << scene.load()
+                    << " game_us=" << gameUs.load() << " callbacks=" << callbacks.load() << " audio_frames=" << audioFrames.load() << " overflow_threads=" << overflowThreads.load() << '\n';
+                for(unsigned i=0;i<count;++i) {
+                    auto& lane=lanes[i];
+                    out << now << " THREAD lane=" << i << " tid=" << lane.tid.load()
+                        << " role=" << lane.role.load() << " phase=" << lane.phase.load()
+                        << " phase_age_ms=" << now-lane.entered.load()
+                        << " touched_age_ms=" << now-lane.touched.load() << '\n';
+                }
+                if(now-frameTick.load()>=5000)
+                    out << now << " STALL_HINT main has not completed a frame for >=5s; inspect phase (dialog/loading may be intentional)\n";
+                if(std::string_view{scene.load()}=="play" && now-lastGameChange>=5000)
+                    out << now << " PROGRESS_HINT game time unchanged >=5s; pause or stalled transport may explain this\n";
+                lastHeartbeat=now;
+            }
+            out.flush();
+            if(!out) throw std::runtime_error("QA event log write failed");
+            const auto position=out.tellp(); if(position>=0) bytes=static_cast<std::uint64_t>(position);
+            if(bytes>=8*1024*1024) { part=(part+1)%4; ++generation; open(); }
+            if(finalDrain) break;
+            if(stopping.load()) continue;
+            std::this_thread::sleep_for(std::chrono::milliseconds(100));
+        }
+    } catch(...) { writerFailed=true; }
+}
+inline bool Start(const std::filesystem::path& root) noexcept {
+    if(enabled) return true;
+    try {
+        auto id=std::to_string(std::chrono::duration_cast<std::chrono::milliseconds>(
+            std::chrono::system_clock::now().time_since_epoch()).count());
+#ifdef _WIN32
+        id+="-pid"+std::to_string(GetCurrentProcessId());
+#endif
+        sessionPath=root/("session-"+id);
+        std::filesystem::create_directories(sessionPath);
+        std::ofstream info{sessionPath/"session.txt"};
+        if(!info) return false;
+        info << "KSM QA flight recorder V1\nstarted_unix_ms_pid=" << id
+             << "\nmax_event_files=4 x approximately 8MiB; normal event writes flush every 100ms"
+             << "\nproducer_lanes=32; ring_events_per_lane=512; overwritten events counted"
+             << "\nNo audio PCM, raw key history, passwords or full memory dump is collected."
+             << "\nThread phases and counters are observations, not proof of a particular driver defect.\n";
+        info.close();
+        frameTick=Now(); stopping=false; writerFailed=false; enabled=true;
+        Role("main"); Event("SESSION_START");
+        writer=std::thread{WriterLoop};
+        return true;
+    } catch(...) { enabled=false; return false; }
+}
+inline void Stop() noexcept {
+    if(!enabled) return;
+    Event("SESSION_STOP"); stopping=true;
+    if(writer.joinable()) writer.join();
+    enabled=false;
+}
+struct SessionGuard { ~SessionGuard() { Stop(); } };
+} // namespace ksmaudio::qa
