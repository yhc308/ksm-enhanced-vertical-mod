+#pragma once
+#include <functional>
+#include <map>
+#include <vector>
+namespace ksmaudio::detail {
+struct OutputResource {
+    std::function<void()> capture;
+    std::function<void()> release;
+    std::function<void()> rebuild;
+    std::function<void()> resume;
+};
+// Process lifetime: addon-owned sounds can outlive ordinary static objects.
+inline auto& OutputResources() { static auto* resources = new std::map<const void*, OutputResource>; return *resources; }
+inline std::vector<OutputResource> ResourceSnapshot() {
+    std::vector<OutputResource> result;
+    for (const auto& [key, hooks] : OutputResources()) result.push_back(hooks);
+    return result;
+}
+}
