+        const InitTraceScope initTrace{request.progress};
+        progress("capture playback state");
+        const auto resources = detail::ResourceSnapshot();
+        for (const auto& resource : resources) resource.capture();
+        auto release = [&] { ReleaseOutput(progress); };
+        auto rebuild = [&] {
+            OutputBatchLock lock;
+            progress("rebuild streams and samples");
+            for (const auto& resource : resources) resource.rebuild();
+            progress("resume playback");
+            for (const auto& resource : resources) resource.resume();
+#ifdef _WIN32
+            if (IsASIOActive()) s_lastCallback = GetTickCount64();
+#endif
+        };
+        release();
+        try {
+            progress("initialize selected output");
+            if (!Init(window, request.backend, request.driver) || s_status.backend != request.backend)
+                throw std::runtime_error(s_status.warning.empty() ? "Cannot initialize selected output" : s_status.warning);
+            rebuild(); result.success = result.available = true; progress("complete"); return result;
+        } catch (const std::exception& error) { result.error = error.what(); }
+        release();
+        try {
+            progress("restore previous output");
+            if (!Init(window, previous.backend, previous.backend == AudioBackend::ASIO ? previous.driver : "") || s_status.backend != previous.backend)
+                throw std::runtime_error("Previous output unavailable");
+            rebuild(); result.restoredPrevious = result.available = true; return result;
+        } catch (const std::exception& error) { result.error += std::string("; restore: ") + error.what(); }
+        release();
+        try {
+            progress("initialize fallback output");
+            if (!Init(window)) throw std::runtime_error("Default output unavailable");
+            rebuild(); result.available = true; return result;
+        } catch (const std::exception& error) { result.error += std::string("; default: ") + error.what(); }
+        release(); return result;
+    }
+    bool IsASIOActive()
+    {
+#ifdef _WIN32
+        return s_asioInitialized && s_mixer && s_status.backend == AudioBackend::ASIO;
+#else
+        return false;
+#endif
+    }
+    std::vector<std::string> GetASIODrivers()
+    {
+        std::vector<std::string> drivers;
+#ifdef _WIN32
+        if (!LoadASIO()) return drivers;
+        BASS_ASIO_DEVICEINFO info{};
+        for (DWORD i = 0; s_api.asioGetDeviceInfo(i, &info); ++i)
+            drivers.push_back(UTF8(reinterpret_cast<const wchar_t*>(info.name)));
+#endif
+        return drivers;
+    }
+    const AudioOutputStatus& GetAudioOutputStatus()
+    {
+#ifdef _WIN32
+        if (IsASIOActive() && s_callbackFrames.load()) s_status.bufferSamples = s_callbackFrames.load();
+#endif
+        return s_status;
+    }
+    std::string GetAudioOutputFailure()
+    {
+#ifdef _WIN32
+        if (IsASIOActive())
+        {
+            if (s_reset.load()) return "ASIO driver requested a reset or changed sample rate. Restart the game after adjusting the driver.";
+            if (s_callbackError.load()) return "ASIO mixer failed to supply audio.";
+            if (GetTickCount64() - s_lastCallback.load() > 2000 || !s_api.asioIsStarted())
+                return "ASIO output stopped. Check the audio interface connection and restart the game.";
+        }
+#endif
+        return {};
+    }
+    namespace {
+        void ReleaseOutput(const std::function<void(const char*)>& progress) {
+            const auto report = [&](const char* phase) { if (progress) progress(phase); };
+#ifdef _WIN32
+            report("stop ASIO callbacks");
+            if (s_asioInitialized && s_api.asioIsStarted()) qa::Call("BASS_ASIO_Stop",0,[&]{ return s_api.asioStop(); },[&]{return s_api.asioErrorGetCode();});
+#endif
+            report("release streams and samples");
+            CancelScheduledSounds();
+            for (const auto& resource : detail::ResourceSnapshot()) resource.release();
+#ifdef _WIN32
+            report("close ASIO device and mixer");
+            CloseASIO();
+#endif
+            report("free BASS output");
+            qa::Call("BASS_Free",0,[]{ return BASS_Free(); },[]{return BASS_ErrorGetCode();}); s_available = false; s_reportedValid = false; s_status = {};
+            CancelScheduledSounds();
+        }
+    }
+    void Terminate() { qa::Scope terminate{"audio.Terminate",true}; ReleaseOutput({}); }
+    int GetLastErrorCode() { return BASS_ErrorGetCode(); }
+    void SetMute(bool value) { s_isMuted = value; ApplyVolume(); }
+    void SetMasterVolume(double value)
+    {
+        s_masterVolume = std::isfinite(value) ? std::clamp(value, 0.0, 1.0) : 1.0;
+        ApplyVolume();
+    }
+    namespace detail
+    {
+        void ForgetChannel(DWORD channel) { qa::Scope wait{"ForgetChannel.wait_mutex",true,channel}; std::lock_guard guard(s_outputMutex); s_origins.erase(channel); }
+        void LockOutput() { qa::Scope wait{"output.wait_mutex"}; s_outputMutex.lock(); }
+        void UnlockOutput() { s_outputMutex.unlock(); }
+        std::uint64_t OutputFrame() { return s_outputFrame; }
+        std::uint64_t OutputGeneration() { return s_generation; }
+        bool ScheduleSample(const Sample* sample, std::uint64_t frame, double volume) {
+            std::lock_guard guard(s_outputMutex);
+            if (!IsASIOActive()) return false;
+            for (auto& event : s_events) if (!event.owner) {
+                if (frame < s_outputFrame) ++s_lateEvents;
+                event = {sample, (std::max)(frame, s_outputFrame), volume}; ++s_scheduledEvents; return true;
+            }
+            ++s_rejectedEvents; return false;
+        }
+        void CancelSample(const Sample* sample) {
+            qa::Scope wait{"CancelSample.wait_mutex"};
+            std::lock_guard guard(s_outputMutex);
+            for (auto& event : s_events) if (!sample || event.owner == sample) event.owner = nullptr;
+        }
+        bool AttachOutputChannel(DWORD channel)
+        {
+            qa::Scope attach{"mixer.AttachOutputChannel",true,channel};
+#ifdef _WIN32
+            if (IsASIOActive()) {
+                std::lock_guard guard(s_outputMutex);
+                if (!s_api.mixStreamAddChannel(s_mixer, channel,
+                    BASS_MIXER_CHAN_PAUSE | BASS_MIXER_CHAN_BUFFER | BASS_MIXER_CHAN_NORAMP | BASS_MIXER_CHAN_NORAMPIN | BASS_MIXER_CHAN_DOWNMIX)) return false;
+                s_origins[channel] = {0, s_outputFrame, 0, true}; return true;
+            }
+#endif
+            return true;
+        }
+        bool PlayOutputChannel(DWORD channel, bool restart)
+        {
+            qa::Scope qaHelper{"PlayOutputChannel.wait_mutex"};
+            std::lock_guard guard(s_outputMutex);
+            qa::Phase("PlayOutputChannel.native");
+#ifdef _WIN32
+            if (IsMixed(channel))
+            {
+                auto it = s_origins.find(channel);
+                if (restart || s_api.mixChannelIsActive(channel) == BASS_ACTIVE_STOPPED) {
+                    if (!s_api.mixChannelSetPosition(channel, 0, BASS_POS_BYTE)) return false;
+                    if (it != s_origins.end()) it->second = {0, s_outputFrame, 0, false};
+                } else if (it != s_origins.end() && it->second.paused) {
+                    const auto position = it->second.pausedPosition;
+                    if (!s_api.mixChannelSetPosition(channel, position, BASS_POS_BYTE)) return false;
+                    it->second = {position, s_outputFrame, position, false};
+                }
+                return s_api.mixChannelFlags(channel, 0, BASS_MIXER_CHAN_PAUSE) != static_cast<DWORD>(-1);
+            }
+#endif
+            return BASS_ChannelPlay(channel, restart) != FALSE;
+        }
+        bool PauseOutputChannel(DWORD channel)
+        {
+            qa::Scope qaHelper{"PauseOutputChannel.wait_mutex"};
+            std::lock_guard guard(s_outputMutex);
+            qa::Phase("PauseOutputChannel.native");
+#ifdef _WIN32
+            if (IsMixed(channel)) {
+                const QWORD position = OutputChannelGetPosition(channel);
+                const bool ok = s_api.mixChannelFlags(channel, BASS_MIXER_CHAN_PAUSE, BASS_MIXER_CHAN_PAUSE) != static_cast<DWORD>(-1);
+                const auto it = s_origins.find(channel);
+                if (ok && it != s_origins.end()) { it->second.pausedPosition = position; it->second.paused = true; }
+                return ok;
+            }
+#endif
+            return BASS_ChannelPause(channel) != FALSE;
+        }
+        bool StopOutputChannel(DWORD channel)
+        {
+            qa::Scope qaHelper{"StopOutputChannel.wait_mutex"};
+            std::lock_guard guard(s_outputMutex);
+            qa::Phase("StopOutputChannel.native");
+#ifdef _WIN32
+            if (IsMixed(channel))
+            {
+                PauseOutputChannel(channel);
+                return OutputChannelSetPosition(channel, 0);
+            }
+#endif
+            return BASS_ChannelStop(channel) != FALSE;
+        }
+        DWORD OutputChannelIsActive(DWORD channel)
+        {
+            qa::Scope qaHelper{"OutputChannelIsActive.wait_mutex"};
+            std::lock_guard guard(s_outputMutex);
+            qa::Phase("OutputChannelIsActive.native");
+#ifdef _WIN32
+            if (IsMixed(channel)) return s_api.mixChannelIsActive(channel);
+#endif
+            return BASS_ChannelIsActive(channel);
+        }
+        QWORD OutputChannelGetRenderPosition(DWORD channel) {
+            qa::Scope qaHelper{"OutputChannelGetRenderPosition.wait_mutex"};
+            std::lock_guard guard(s_outputMutex);
+            qa::Phase("OutputChannelGetRenderPosition.native");
+#ifdef _WIN32
+            if (IsMixed(channel)) {
+                // The decoder can prefetch during resampling/tempo processing. Use the mixer
+                // timeline at zero delay, not the raw decoder cursor, for sample scheduling.
+                const QWORD position = s_api.mixChannelGetPositionEx(channel, BASS_POS_BYTE, 0);
+                if (position != static_cast<QWORD>(-1)) return position;
+            }
+#endif
+            return BASS_ChannelGetPosition(channel, BASS_POS_BYTE);
+        }
+        QWORD OutputChannelGetPosition(DWORD channel)
+        {
+            qa::Scope qaHelper{"OutputChannelGetPosition.wait_mutex"};
+            std::lock_guard guard(s_outputMutex);
+            qa::Phase("OutputChannelGetPosition.native");
+#ifdef _WIN32
+            if (IsMixed(channel))
+            {
+                const auto origin = s_origins.find(channel);
+                if (origin != s_origins.end()) {
+                    if (origin->second.paused) return origin->second.pausedPosition;
+                    if ((s_outputFrame - origin->second.frame) < s_status.latencySec * s_status.sampleRate)
+                        return origin->second.position;
+                }
+                if (s_api.mixChannelFlags(channel, 0, 0) & BASS_MIXER_CHAN_PAUSE)
+                    return BASS_ChannelGetPosition(channel, BASS_POS_BYTE);
+                const DWORD delay = static_cast<DWORD>(s_status.latencySec * s_status.sampleRate) * 2 * sizeof(float);
+                const QWORD pos = s_api.mixChannelGetPositionEx(channel, BASS_POS_BYTE, delay);
+                // At startup/after seek, history may not yet cover the output latency.
+                if (pos != static_cast<QWORD>(-1)) return pos;
+                const QWORD decoded = BASS_ChannelGetPosition(channel, BASS_POS_BYTE);
+                if (decoded == static_cast<QWORD>(-1)) return 0;
+                const QWORD sourceDelay = BASS_ChannelSeconds2Bytes(channel, s_status.latencySec);
+                return decoded > sourceDelay ? decoded - sourceDelay : 0;
+            }
+#endif
+            return BASS_ChannelGetPosition(channel, BASS_POS_BYTE);
+        }
+        bool OutputChannelSetPosition(DWORD channel, QWORD pos)
+        {
+            qa::Scope qaHelper{"OutputChannelSetPosition.wait_mutex"};
+            std::lock_guard guard(s_outputMutex);
+            qa::Phase("OutputChannelSetPosition.native");
+#ifdef _WIN32
+            if (IsMixed(channel)) {
+                const bool ok = s_api.mixChannelSetPosition(channel, pos, BASS_POS_BYTE) != FALSE;
+                const auto it = s_origins.find(channel);
+                if (ok && it != s_origins.end()) it->second = {pos, s_outputFrame, pos, it->second.paused};
+                return ok;
+            }
+#endif
+            return BASS_ChannelSetPosition(channel, pos, BASS_POS_BYTE) != FALSE;
+        }
+        DWORD OutputChannelGetData(DWORD channel, void* buffer, DWORD length)
+        {
+#ifdef _WIN32
+            if (IsMixed(channel)) return s_api.mixChannelGetData(channel, buffer, length);
+#endif
+            return BASS_ChannelGetData(channel, buffer, length);
+        }
+    }
 }
