+            for(size_t i=0;i<m_events.size();++i)m_events[i].phase=i%7;
+        }
+        const PreviewChipEvent* nextDue(double now){if(m_cursor==m_events.size() || now<m_events[m_cursor].timeSec)return nullptr;return &m_events[m_cursor++];}
