 namespace MusicGame::Judgment
 {
+	struct PreviewChipEvent
+	{
+		kson::Pulse pulse;
+		int32 lane;
+		double timeSec;
+		size_t phase = 0;
+	};
+	struct PreviewChipOutcome
+	{
+		JudgmentResult result;
+		double exampleMs;
+	};
+	inline constexpr std::array<PreviewChipOutcome, 7> kPreviewChipOutcomes{ { { JudgmentResult::kError, 150 }, { JudgmentResult::kNearFast, 75 }, { JudgmentResult::kCritical, 30 }, { JudgmentResult::kCritical, 0 }, { JudgmentResult::kCritical, -35 }, { JudgmentResult::kNearSlow, -95 }, { JudgmentResult::kError, -150 } } };
+	class PreviewChipSequence
+	{
+		Array<PreviewChipEvent> m_events;
+		size_t m_cursor = 0;
+
+	public:
+		PreviewChipSequence(const kson::ChartData& chart, const kson::TimingCache& cache, bool enabled)
+		{
+			if (!enabled)
+				return;
+			const auto add = [&](const auto& lane, int32 id)
+			{
+				for (const auto& [pulse, note] : lane)
+					if (note.length == 0)
+						m_events.push_back({ pulse, id, kson::PulseToSec(pulse, chart.beat, cache) });
+			};
+			for (int32 i = 0; i < 4; ++i)
+				add(chart.note.bt[i], i);
+			for (int32 i = 0; i < 2; ++i)
+				add(chart.note.fx[i], i + 4);
+			m_events.sort_by([](const auto& a, const auto& b)
+							 {
+								 return a.pulse != b.pulse ? a.pulse < b.pulse : a.lane < b.lane;
+							 });
+			for (size_t i = 0; i < m_events.size(); ++i)
+				m_events[i].phase = i % 7;
+		}
+		const PreviewChipEvent* nextDue(double now)
+		{
+			if (m_cursor == m_events.size() || now < m_events[m_cursor].timeSec)
+				return nullptr;
+			return &m_events[m_cursor++];
+		}
+		size_t processed() const
+		{
+			return m_cursor;
+		}
+		size_t size() const
+		{
+			return m_events.size();
+		}
+	};
